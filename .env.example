# ==== Kraken Code Booking — environment variables ====
# Set these in Vercel: Project → Settings → Environment Variables
# (Never commit real values. This file is a template only.)

# Your Gmail address (sender + default recipient of admin notifications)
GMAIL_USER=usamaabubakr45@gmail.com

# Google App Password (Account → Security → 2-Step Verification → App passwords)
# Format: 16 characters, spaces optional e.g. abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=replace-with-your-app-password

# Where owner/admin booking notifications go (defaults to GMAIL_USER)
OWNER_EMAIL=usamaabubakr45@gmail.com

# Optional: lock CORS to your site origin (default allows all)
# ALLOW_ORIGIN=https://your-domain.com

# Optional: business timezone (default Asia/Karachi)
# BOOKING_TZ=Asia/Karachi

# Optional: auto-provided when you add Vercel KV storage (enables
# double-booking protection). Leave unset and bookings still work.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
